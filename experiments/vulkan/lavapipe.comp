#version 450
// Research-only software-device probe; no production backend registration.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer A { float a[]; };
layout(set = 0, binding = 1, std430) readonly buffer B { float b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Output { float result[]; };
layout(push_constant) uniform Parameters { uint count; uint operation; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    result[i] = pc.operation == 0 ? a[i] + b[i] : a[i] * b[i];
}
