[
  {
    "ref": "tensorcx_www_to_apex",
    "description": "Redirect www to the canonical tensor.cx hostname",
    "expression": "http.host eq \"www.tensor.cx\"",
    "action": "redirect",
    "action_parameters": {
      "from_value": {
        "status_code": 301,
        "target_url": {
          "expression": "concat(\"https://tensor.cx\", http.request.uri.path)"
        },
        "preserve_query_string": true
      }
    },
    "enabled": true
  }
]
