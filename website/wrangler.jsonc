{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tensorcx-website",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "tensor.cx", "custom_domain": true },
    { "pattern": "www.tensor.cx", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
